{
  "layout": {
    "type": "layout",
    "pages": [
      "page-general"
    ],
    "page-general": {
      "type": "page",
      "title": "General",
      "sections": [
        "section-folders",
        "section-rotation",
        "section-carousel",
        "section-monitors"
      ]
    },
    "section-folders": {
      "type": "section",
      "title": "Folders",
      "keys": [
        "global-folder",
        "favorites-folder"
      ]
    },
    "section-rotation": {
      "type": "section",
      "title": "Rotation",
      "keys": [
        "interval-minutes",
        "interval-seconds",
        "image-order",
        "show-notifications"
      ]
    },
    "section-carousel": {
      "type": "section",
      "title": "Carousel",
      "keys": [
        "carousel-edge",
        "carousel-thumb-size",
        "carousel-file-names",
        "carousel-close-on-pick"
      ]
    },
    "section-monitors": {
      "type": "section",
      "title": "Monitors",
      "keys": [
        "sync-mode",
        "detection-poll-enabled",
        "detection-interval-minutes"
      ]
    }
  },
  "interval-minutes": {
    "type": "spinbutton",
    "default": 5,
    "min": 0,
    "max": 1440,
    "step": 1,
    "units": "minutes",
    "description": "Change wallpaper every (minutes; 0 = use seconds only)"
  },
  "interval-seconds": {
    "type": "spinbutton",
    "default": 0,
    "min": 0,
    "max": 59,
    "step": 1,
    "units": "seconds",
    "description": "Additional seconds"
  },
  "detection-interval-minutes": {
    "type": "spinbutton",
    "default": 30,
    "min": 1,
    "max": 1440,
    "step": 1,
    "units": "minutes",
    "description": "Re-check for monitor / port changes every (minutes)",
    "dependency": "detection-poll-enabled"
  },
  "image-order": {
    "type": "combobox",
    "default": "no-repeat",
    "options": {
      "Random (no repeats)": "no-repeat",
      "Random (may repeat)": "random",
      "Sequential (A\u2013Z)": "sequential"
    },
    "description": "Image rotation order"
  },
  "show-notifications": {
    "type": "switch",
    "default": false,
    "description": "Show notification when wallpaper changes"
  },
  "global-folder": {
    "type": "filechooser",
    "default": "",
    "select-dir": true,
    "description": "Default wallpaper folder \u2014 fallback for any monitor without its own folder, and the shared pool in Sync Mode"
  },
  "favorites-folder": {
    "type": "filechooser",
    "default": "",
    "select-dir": true,
    "description": "Folder to save favorited wallpapers (default: ~/Pictures/Wallpaper Favorites)"
  },
  "sync-mode": {
    "type": "switch",
    "default": false,
    "description": "Same image on all monitors (uses the default wallpaper folder above)"
  },
  "detection-poll-enabled": {
    "type": "switch",
    "default": true,
    "description": "Re-check for monitor changes on a timer"
  },
  "carousel-edge": {
    "type": "combobox",
    "default": "bottom",
    "options": {
      "Bottom edge": "bottom",
      "Top edge": "top"
    },
    "description": "Carousel comes in from the (left or right on a portrait monitor)"
  },
  "carousel-thumb-size": {
    "type": "combobox",
    "default": "medium",
    "options": {
      "Small": "small",
      "Medium": "medium",
      "Large": "large"
    },
    "description": "Thumbnail size"
  },
  "carousel-file-names": {
    "type": "combobox",
    "default": "hover",
    "options": {
      "On hover": "hover",
      "Always": "always",
      "Never": "never"
    },
    "description": "Show file names on thumbnails"
  },
  "carousel-close-on-pick": {
    "type": "switch",
    "default": false,
    "description": "Close the carousel after choosing an image"
  }
}
