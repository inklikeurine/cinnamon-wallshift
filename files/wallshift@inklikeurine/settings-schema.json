{
  "layout": {
    "type": "layout",
    "pages": [
      "page-general"
    ],
    "page-general": {
      "type": "page",
      "title": "General",
      "sections": [
        "section-folders",
        "section-rotation",
        "section-carousel",
        "section-monitors"
      ]
    },
    "section-folders": {
      "type": "section",
      "title": "Folders",
      "keys": [
        "global-folder",
        "favorites-folder"
      ]
    },
    "section-rotation": {
      "type": "section",
      "title": "Rotation",
      "keys": [
        "interval-minutes",
        "interval-seconds",
        "image-order",
        "show-notifications"
      ]
    },
    "section-carousel": {
      "type": "section",
      "title": "Carousel",
      "keys": [
        "carousel-edge",
        "carousel-thumb-size",
        "carousel-file-names",
        "carousel-close-on-pick"
      ]
    },
    "section-monitors": {
      "type": "section",
      "title": "Monitors",
      "keys": [
        "sync-mode",
        "detection-poll-enabled",
        "detection-interval-minutes"
      ]
    }
  },
  "interval-minutes": {
    "type": "spinbutton",
    "default": 5,
    "min": 0,
    "max": 1440,
    "step": 1,
    "units": "minutes",
    "description": "Change every",
    "tooltip": "Minutes and seconds between wallpaper changes; the minimum is 10 seconds"
  },
  "interval-seconds": {
    "type": "spinbutton",
    "default": 0,
    "min": 0,
    "max": 59,
    "step": 1,
    "units": "seconds",
    "description": "Change every (seconds)"
  },
  "detection-interval-minutes": {
    "type": "spinbutton",
    "default": 30,
    "min": 1,
    "max": 1440,
    "step": 1,
    "units": "minutes",
    "description": "Every",
    "dependency": "detection-poll-enabled"
  },
  "image-order": {
    "type": "combobox",
    "default": "no-repeat",
    "options": {
      "Random (no repeats)": "no-repeat",
      "Random (may repeat)": "random",
      "Sequential (A\u2013Z)": "sequential"
    },
    "description": "Order"
  },
  "show-notifications": {
    "type": "switch",
    "default": false,
    "description": "Notify when the wallpaper changes"
  },
  "global-folder": {
    "type": "filechooser",
    "default": "",
    "select-dir": true,
    "description": "Wallpaper folder",
    "tooltip": "The default folder: used by every monitor without a folder of its own, and by Sync mode"
  },
  "favorites-folder": {
    "type": "filechooser",
    "default": "",
    "select-dir": true,
    "description": "Favorites folder",
    "tooltip": "Starred wallpapers are copied here (default: ~/Pictures/Wallpaper Favorites)"
  },
  "sync-mode": {
    "type": "switch",
    "default": false,
    "description": "Same image on all monitors",
    "tooltip": "Uses the wallpaper folder above on every monitor"
  },
  "detection-poll-enabled": {
    "type": "switch",
    "default": true,
    "description": "Re-check for monitor changes",
    "tooltip": "When off, Wallshift still reacts when Cinnamon reports a monitor change; only the timed re-check stops."
  },
  "carousel-edge": {
    "type": "combobox",
    "default": "bottom",
    "options": {
      "Bottom edge": "bottom",
      "Top edge": "top"
    },
    "description": "Comes in from the",
    "tooltip": "Top edge or bottom edge; left (top) or right (bottom) on a portrait monitor. It always stays clear of panels, including ones that hide themselves."
  },
  "carousel-thumb-size": {
    "type": "combobox",
    "default": "medium",
    "options": {
      "Small": "small",
      "Medium": "medium",
      "Large": "large"
    },
    "description": "Thumbnail size"
  },
  "carousel-file-names": {
    "type": "combobox",
    "default": "hover",
    "options": {
      "On hover": "hover",
      "Always": "always",
      "Never": "never"
    },
    "description": "Show file names"
  },
  "carousel-close-on-pick": {
    "type": "switch",
    "default": false,
    "description": "Close after choosing an image"
  }
}
