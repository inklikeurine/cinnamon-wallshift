{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 ../cinnamon-tools/tools/*)",
      "Bash(/usr/bin/python3 ../cinnamon-tools/tools/*)",
      "Bash(python3 ../cinnamon-tools/harness/*)",
      "Bash(/usr/bin/python3 ../cinnamon-tools/harness/*)",
      "Bash(cjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "additionalDirectories": ["../cinnamon-tools", "../_workshop"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/../cinnamon-tools/tools/on_edit.py\" ]; then /usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../cinnamon-tools/tools/on_edit.py\"; fi",
            "timeout": 60,
            "statusMessage": "Validating applet…"
          }
        ]
      }
    ]
  }
}
